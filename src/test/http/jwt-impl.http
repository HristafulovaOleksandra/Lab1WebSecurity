### 0a. Логін ADMIN (Oleksandra) -> токен запам'ятовується
POST http://localhost:8080/auth/authenticate
Content-Type: application/json

{ "email": "oleksandra@mail.com", "password": "admin" }

> {% client.global.set("admin_token", response.body.token); %}

### 0b. Логін USER (Tom) -> токен запам'ятовується
POST http://localhost:8080/auth/authenticate
Content-Type: application/json

{ "email": "tom@mail.com", "password": "user" }

> {% client.global.set("user_token", response.body.token); %}

### 0c. Логін SUPERADMIN (Peter) -> токен запам'ятовується
POST http://localhost:8080/auth/authenticate
Content-Type: application/json

{ "email": "peter@mail.com", "password": "superadmin" }

> {% client.global.set("super_token", response.body.token); %}

### 1. ADMIN -> /hello/admin (200)
GET http://localhost:8080/api/v1/items/hello/admin
Authorization: Bearer {{admin_token}}

> {% client.test("ADMIN -> /hello/admin = 200", function () { client.assert(response.status === 200, "got " + response.status); }); %}

