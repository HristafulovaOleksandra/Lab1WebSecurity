### 1. ADMIN -> /hello/admin (очікуємо 200)
GET http://localhost:8080/api/v1/items/hello/admin
Authorization: Basic admin admin

> {%
    client.test("admin -> /hello/admin = 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 2. USER -> /hello/admin (очікуємо 403, бо не адмін)
GET http://localhost:8080/api/v1/items/hello/admin
Authorization: Basic user user

> {%
    client.test("user -> /hello/admin = 403", function () {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

